#!/usr/bin/env bash
# One person's JupyterLab workspace beside the compose API and workers. No seeded content, no model calls.
#   scripts/workspace up [username]   build the image, start JupyterLab and its notebook control
#                                     server, open a kernel and write the private workspace map
#                                     (username defaults to analyst)
#   scripts/workspace down            stop them; the workspace files stay in the workspace-root volume
# JupyterLab is at http://localhost:18881 (sign in with the token in .local/runtime/workspace).
# CSA templates in .local/templates/csa appear read-only at templates/csa. Nothing secret is printed.
set -euo pipefail
cd "$(dirname "$0")/.."
[ -f .env ] || { echo "Missing .env (in a worktree: ln -s <main checkout>/.env .env)" >&2; exit 1; }
export DOCKER_CONTEXT=${DOCKER_CONTEXT:-colima} UV_NO_PROGRESS=1
while IFS='=' read -r key value; do
  [[ $key =~ ^[A-Z_][A-Z0-9_]*$ ]] || continue
  [ -n "${!key+x}" ] || export "$key=$value"
done < .env
STATE=.local/runtime/workspace
PORT=18881 BRIDGE_PORT=18790
mkdir -p "$STATE/map" .local/templates/csa
chmod 700 "$STATE"

secret() { [ -s "$STATE/$1" ] || (umask 077; python3 -c 'import secrets; print(secrets.token_urlsafe(32), end="")' > "$STATE/$1"); }
profile() {
  WORKSPACE_JUPYTER_TOKEN=$(cat "$STATE/jupyter-token") WORKSPACE_MCP_TOKEN=$(cat "$STATE/mcp-token") \
    docker compose --profile workspace "$@"
}

up() {
  local user=${1:-analyst} owner
  secret jupyter-token
  secret mcp-token
  docker compose up -d --wait db app >/dev/null
  owner=$(docker compose exec -T db psql -U postgres -d "${CRAFT_DATABASE_NAME:-craft_dev}" -Atc \
    "select id from users where username = '$user' and disabled_at is null")
  [ -n "$owner" ] || { echo "No active user $user; run scripts/seed or craft users approve first" >&2; exit 1; }
  CRAFT_DATABASE_HOST=127.0.0.1 uv run -q craft call accounts.create_workspace_token --as "$user" \
    '{"label": "local workspace", "hours": 168}' \
    | python3 -c 'import json, sys; print(json.load(sys.stdin)["token"], end="")' > "$STATE/workspace-token"
  chmod 644 "$STATE/workspace-token"  # read by the unprivileged container user through a read-only mount

  echo "Building and starting the workspace"
  profile build -q workspace workspace-mcp
  profile up -d workspace workspace-mcp >/dev/null
  local token
  token=$(cat "$STATE/jupyter-token")
  for _ in $(seq 60); do
    curl -fs -o /dev/null -H "Authorization: token $token" "http://127.0.0.1:$PORT/api/status" && break
    sleep 1
  done

  # One notebook and kernel the agent's runs work in, then the private map the app reads.
  (umask 077; python3 - "$PORT" "$STATE" "$owner" "$BRIDGE_PORT" <<'MAP'
import json, sys, urllib.request
from pathlib import Path
port, state, owner, bridge = sys.argv[1:]
read = lambda name: Path(state, name).read_text()
def call(method, path, body=None):
    request = urllib.request.Request(
        f"http://127.0.0.1:{port}{path}", method=method,
        data=None if body is None else json.dumps(body).encode(),
        headers={"Authorization": "token " + read("jupyter-token"), "Content-Type": "application/json"})
    with urllib.request.urlopen(request) as response:
        return json.loads(response.read() or b"null")
try:
    call("GET", "/api/contents/analysis.ipynb?content=0")
except Exception:
    call("PUT", "/api/contents/analysis.ipynb", {"type": "notebook", "content": {
        "cells": [], "metadata": {}, "nbformat": 4, "nbformat_minor": 5}})
session = call("POST", "/api/sessions", {"path": "analysis.ipynb", "type": "notebook", "kernel": {"name": "python3"}})
Path(state, "map", "workspaces.json").write_text(json.dumps({owner: {
    "url": "http://workspace-mcp:4040/mcp",
    "headers": {"Authorization": "Bearer " + read("mcp-token")},
    "tools": ["list_files", "list_notebooks", "read_notebook"],
    "jupyter": {
        "url": "http://workspace:8888/",
        "token": read("jupyter-token"),
        "kernel_id": session["kernel"]["id"],
        "bridge_host": "app",
        "bridge_port": int(bridge),
    },
}}, indent=2))
MAP
  )
  chmod 644 "$STATE/map/workspaces.json"  # read by the app containers through a read-only mount
  echo "Workspace ready for $user: http://localhost:$PORT (token in $STATE/jupyter-token)"
}

down() {
  secret jupyter-token
  secret mcp-token
  profile stop workspace workspace-mcp >/dev/null
  rm -f "$STATE/map/workspaces.json"
  echo "Workspace stopped"
}

case "${1:-}" in
  up) up "${2:-}" ;;
  down) down ;;
  *) echo "usage: scripts/workspace up [username] | down" >&2; exit 2 ;;
esac
