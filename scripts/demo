#!/usr/bin/env bash
# Local demo on real models and a freshly built workspace image.
#   demo go    wipe the demo database and workspace, seed them, start everything, open Chrome
#              (the workspace also gets app/seed/demo-finance-skill.md as a personal skill)
#   demo stop  stop the backend, frontend, workspace and database
# Accounts sign in with password 1 unless DEMO_PASSWORD is set. Generated database
# passwords live in var/demo (ignored by git); nothing secret is printed.
set -euo pipefail

REPO=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
STATE=$REPO/var/demo
DB_PORT=55470 API_PORT=18766 UI_PORT=5200 JUPYTER_PORT=18881 MCP_PORT=4040 BRIDGE_PORT=18790
UI=http://localhost:$UI_PORT
PROJECT=craft-demo
WS=craft-demo-ws
IMAGE=craft-user-workspace:demo
export DOCKER_CONTEXT=colima

say() { printf '\033[1m%s\033[0m\n' "$*"; }
compose() { docker compose -p "$PROJECT" -f "$REPO/compose.yaml" "$@"; }

load_env() {
  mkdir -p "$STATE"; chmod 700 "$STATE"
  local secrets=$STATE/secrets.env
  if [ ! -f "$secrets" ]; then
    (umask 077; for name in CRAFT_DB_ADMIN_PASSWORD CRAFT_OWNER_DB_PASSWORD CRAFT_APP_DB_PASSWORD; do
      echo "$name=$(python3 -c 'import secrets; print(secrets.token_hex(24))')"
    done > "$secrets")
  fi
  set -a
  . "$secrets"
  # demo, restricted and admin sign in to CRAFT and JupyterLab with this local password.
  DEMO_PASSWORD=${DEMO_PASSWORD:-1}
  # Model settings come from the main checkout's .env.
  local main_env
  main_env=$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir)/../.env
  [ -f "$REPO/.env" ] && main_env=$REPO/.env
  eval "$(grep -E '^CRAFT_(MODEL|WOLFRAM)_[A-Z_]+=' "$main_env" || true)"
  CRAFT_DATABASE_HOST=127.0.0.1
  CRAFT_DATABASE_PORT=$DB_PORT
  CRAFT_DATABASE_NAME=craft_dev
  CRAFT_PROVIDER_ROOT=$STATE/provider
  CRAFT_ALLOWED_ORIGINS=$UI
  CRAFT_MCP_URL=http://127.0.0.1:$API_PORT/mcp
  CRAFT_LOG_LEVEL=WARNING
  CRAFT_MODEL_MAX_OUTPUT_TOKENS=12000
  CRAFT_AGENT_RUN_SECONDS=300
  CRAFT_PASSWORD_MIN_LENGTH=1
  SEED_DEMO_PASSWORD=$DEMO_PASSWORD
  USER_WORKSPACES_FILE=$STATE/workspaces.json
  set +a
  [ -n "${CRAFT_MODEL_KEY:-}" ] || { echo "No CRAFT_MODEL_KEY in $main_env" >&2; exit 1; }
}

stop() {
  for name in web api mcp; do
    [ -f "$STATE/$name.pid" ] && kill "$(cat "$STATE/$name.pid")" 2>/dev/null || true
    rm -f "$STATE/$name.pid"
  done
  for port in $UI_PORT $API_PORT $MCP_PORT; do
    lsof -ti "tcp:$port" -sTCP:LISTEN 2>/dev/null | xargs kill 2>/dev/null || true
  done
  if colima status >/dev/null 2>&1; then
    docker rm -f "$WS" >/dev/null 2>&1 || true
    docker compose -p "$PROJECT" stop >/dev/null 2>&1 || true
  fi
}

wait_for() {
  for _ in $(seq 120); do curl -fs -o /dev/null "$@" && return; sleep 1; done
  echo "Timed out waiting for $*" >&2; exit 1
}

go() {
  load_env
  cd "$REPO"
  colima status >/dev/null 2>&1 || { say "Starting Docker"; colima start; }
  say "Rebuilding the demo at $UI (about 5 minutes). Open tabs cannot sign in until it is ready."
  say "Stopping and wiping the last demo"
  stop
  docker compose -p "$PROJECT" down -v --remove-orphans >/dev/null 2>&1 || true
  docker volume rm -f "$WS-root" >/dev/null 2>&1 || true
  rm -rf "$STATE/provider" "$STATE/workspace" "$STATE/workspaces.json"

  say "Installing dependencies"
  uv sync -q
  [ -d web/node_modules ] || npm --prefix web ci --silent
  if [ ! -x "$STATE/mcpctl/bin/jupyter-mcp-server" ]; then
    uv venv -q --python 3.12 "$STATE/mcpctl"
    uv pip install -q --python "$STATE/mcpctl/bin/python" jupyter-mcp-server==2.2.4
  fi

  say "Building the workspace image"
  docker build -q -f packages/user_workspace/Dockerfile -t "$IMAGE" packages/user_workspace >/dev/null

  say "Creating and seeding the database"
  compose up -d --wait db >/dev/null
  uv run -q alembic upgrade head
  uv run -q craft seed base >/dev/null
  # Indexing makes one real model call per document; a rerun resumes after a failed call.
  for attempt in 1 2 3; do
    uv run -q craft seed demo > "$STATE/seed.log" 2>&1 && break
    [ "$attempt" = 3 ] && { echo "Seeding failed; see $STATE/seed.log" >&2; exit 1; }
    say "Seeding stopped on a model error; resuming"
  done

  say "Starting the demo workspace"
  workspace

  say "Starting the backend and frontend"
  nohup .venv/bin/uvicorn app.main:app --host 127.0.0.1 --port "$API_PORT" --log-level warning \
    > "$STATE/api.log" 2>&1 & echo $! > "$STATE/api.pid"
  (cd web && CRAFT_BACKEND_URL=http://127.0.0.1:$API_PORT VITE_USER_WORKSPACES="$(cat "$STATE/vite-workspaces.json")" \
    nohup node_modules/.bin/vite --host localhost --port "$UI_PORT" --strictPort > "$STATE/web.log" 2>&1 & echo $! > "$STATE/web.pid")
  wait_for "http://127.0.0.1:$API_PORT/health/ready"
  wait_for "$UI"

  open -a "Google Chrome" "$UI" 2>/dev/null || open "$UI"
  say "Demo ready: $UI"
  echo "  Sign in as demo with password $DEMO_PASSWORD. Reload any older tab."
  echo "  Logs: $STATE. Stop with: demo stop"
}

# One Jupyter container with one kernel, its MCP control server and the private workspace map.
workspace() {
  local w=$STATE/workspace net=$WS-net owner
  mkdir -p "$w"; chmod 700 "$w"
  owner=$(compose exec -T db psql -U postgres -d craft_dev -Atc "select id from users where username = 'demo'")
  uv run -q craft call accounts.create_workspace_token --as demo '{"label": "demo workspace", "hours": 168}' \
    | python3 -c 'import json, sys; print(json.load(sys.stdin)["token"], end="")' > "$w/workspace-token"
  chmod 644 "$w/workspace-token"  # read by the unprivileged container user through a read-only mount
  python3 -c 'import secrets; print(secrets.token_urlsafe(32), end="")' > "$w/jupyter-token"
  python3 -c 'import secrets; print(secrets.token_urlsafe(32), end="")' > "$w/mcp-token"
  chmod 600 "$w/jupyter-token" "$w/mcp-token"
  docker run --rm --network none -e P="$DEMO_PASSWORD" --entrypoint python "$IMAGE" \
    -c 'import os; from jupyter_server.auth import passwd; print(passwd(os.environ["P"]), end="")' > "$w/jupyter-hash"

  docker network inspect "$net" >/dev/null 2>&1 \
    || docker network create --opt com.docker.network.enable_ipv6=false "$net" >/dev/null
  JUPYTER_TOKEN=$(cat "$w/jupyter-token") JUPYTER_PASSWORD_HASH=$(cat "$w/jupyter-hash") \
    docker run -d --name "$WS" --network "$net" \
    --read-only --tmpfs /tmp --cap-drop ALL --security-opt no-new-privileges \
    --memory 2g --cpus 2 --pids-limit 256 --restart no \
    -p "127.0.0.1:$JUPYTER_PORT:8888" \
    -v "$WS-root:/workspace" \
    -v "$w/workspace-token:/run/craft/workspace-token:ro" \
    -e JUPYTER_TOKEN -e JUPYTER_PASSWORD_HASH \
    -e CRAFT_UI_ORIGIN="$UI" \
    -e CRAFT_API_URL="http://host.docker.internal:$API_PORT" \
    "$IMAGE" >/dev/null

  # The workspace may reach only the CRAFT API and its run bridge on the host.
  local subnet
  subnet=$(docker network inspect "$net" --format '{{(index .IPAM.Config 0).Subnet}}')
  colima ssh -- sudo sh -s "$subnet" "$API_PORT" "$BRIDGE_PORT" <<'POLICY'
set -e
subnet=$1; api=$2; bridge=$3
iptables -N CRAFT-WS 2>/dev/null || iptables -F CRAFT-WS
iptables -C DOCKER-USER -s "$subnet" -j CRAFT-WS 2>/dev/null || iptables -I DOCKER-USER -s "$subnet" -j CRAFT-WS
iptables -C INPUT -s "$subnet" -j CRAFT-WS 2>/dev/null || iptables -I INPUT -s "$subnet" -j CRAFT-WS
host=$(getent hosts host.lima.internal | awk '{print $1}')
iptables -A CRAFT-WS -m conntrack --ctstate ESTABLISHED,RELATED -j RETURN
iptables -A CRAFT-WS -d "$host" -p tcp --dport "$api" -j RETURN
iptables -A CRAFT-WS -d "$host" -p tcp --dport "$bridge" -j RETURN
iptables -A CRAFT-WS -j DROP
POLICY

  wait_for -H "Authorization: token $(cat "$w/jupyter-token")" "http://127.0.0.1:$JUPYTER_PORT/api/status"

  python3 - "$JUPYTER_PORT" "$w" "$REPO/app/seed/demo-finance-skill.md" <<'KERNEL'
import json, sys, urllib.request
port, folder, skill = sys.argv[1], sys.argv[2], sys.argv[3]
token = open(folder + "/jupyter-token").read()
def call(method, path, body=None):
    request = urllib.request.Request(
        f"http://127.0.0.1:{port}{path}", method=method,
        data=None if body is None else json.dumps(body).encode(),
        headers={"Authorization": "token " + token, "Content-Type": "application/json"})
    with urllib.request.urlopen(request) as response:
        return json.loads(response.read() or b"null")
notebook = {"type": "notebook", "content": {"cells": [], "metadata": {}, "nbformat": 4, "nbformat_minor": 5}}
call("PUT", "/api/contents/analysis.ipynb", notebook)
call("PUT", "/api/contents/skills/demo-finance-skill.md",
     {"type": "file", "format": "text", "content": open(skill).read()})
session = call("POST", "/api/sessions", {"path": "analysis.ipynb", "type": "notebook", "kernel": {"name": "python3"}})
open(folder + "/kernel-id", "w").write(session["kernel"]["id"])
KERNEL

  JUPYTER_URL=http://127.0.0.1:$JUPYTER_PORT JUPYTER_TOKEN=$(cat "$w/jupyter-token") MCP_TOKEN=$(cat "$w/mcp-token") \
    nohup "$STATE/mcpctl/bin/jupyter-mcp-server" start \
    --transport streamable-http --host 127.0.0.1 --port "$MCP_PORT" \
    --start-new-code-sandbox False --document-provider jupyter \
    --jupyterlab False --reconnect-interval 0 \
    --execution-timeout 120 --max-execution-timeout 120 > "$STATE/mcp.log" 2>&1 &
  echo $! > "$STATE/mcp.pid"

  (umask 077; python3 - "$w" "$owner" "$JUPYTER_PORT" "$MCP_PORT" "$BRIDGE_PORT" "$STATE" <<'MAP'
import json, sys
from pathlib import Path
folder, owner, jupyter, mcp, bridge, state = sys.argv[1:]
read = lambda name: Path(folder, name).read_text()
Path(state, "workspaces.json").write_text(json.dumps({owner: {
    "url": f"http://127.0.0.1:{mcp}/mcp",
    "headers": {"Authorization": "Bearer " + read("mcp-token")},
    "tools": ["list_files", "list_notebooks", "read_notebook"],
    "jupyter": {
        "url": f"http://127.0.0.1:{jupyter}/",
        "token": read("jupyter-token"),
        "kernel_id": read("kernel-id"),
        "bridge_host": "host.docker.internal",
        "bridge_port": int(bridge),
    },
}}, indent=2))
Path(state, "vite-workspaces.json").write_text(json.dumps({owner: f"http://127.0.0.1:{jupyter}/"}))
MAP
  )
}

case "${1:-}" in
  go) go ;;
  stop) stop; say "Demo stopped" ;;
  *) echo "usage: demo go | demo stop" >&2; exit 2 ;;
esac
