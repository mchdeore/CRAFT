# Copy to .env (git-ignored) and set the 3 passwords to any local values.
# postgres superuser: used only by app/infrastructure/database/initdb.sh on first boot
CRAFT_DB_ADMIN_PASSWORD=
# craft_owner: runs migrations
CRAFT_OWNER_DB_PASSWORD=
# craft_app: the app's own login
CRAFT_APP_DB_PASSWORD=
# craft_id: craft-id's login (the stand-in for Entra); set it before the database's first boot
CRAFT_ID_DB_PASSWORD=
CRAFT_DATABASE_HOST=localhost
# change if 5432 is taken on this machine; compose and the app both read it
CRAFT_DATABASE_PORT=5432
CRAFT_DATABASE_NAME=craft_dev
CRAFT_LOG_LEVEL=INFO
CRAFT_PROVIDER_ROOT=.local/runtime/provider
# Where originals are read: simulated (the folder above) or livelink_test (a LiveLink-shaped API
# in front of that folder, `craft provider serve`). Item records stay in the folder either way.
CRAFT_PROVIDER=simulated
CRAFT_PROVIDER_URL=
CRAFT_PROVIDER_TOKEN=
# where the process manager keeps its state; empty turns it off
CRAFT_PROCESS_ROOT=
# background jobs: the queues this worker takes, and jobs at once per queue (10 people at a time)
CRAFT_WORKER_QUEUES=agent,interactive,bulk
CRAFT_WORKER_CONCURRENCY_AGENT=20
CRAFT_WORKER_CONCURRENCY_INTERACTIVE=10
CRAFT_WORKER_CONCURRENCY_BULK=2
CRAFT_SESSION_IDLE_HOURS=8
CRAFT_SESSION_ABSOLUTE_HOURS=12
CRAFT_SIGN_IN_ATTEMPTS_PER_MINUTE=5
CRAFT_PASSWORD_MIN_LENGTH=12
CRAFT_ALLOWED_ORIGINS=http://localhost:8000
# Foundry project endpoint and key; model features refuse until both are set
CRAFT_MODEL_MAIN=gpt-5.2
CRAFT_MODEL_CHECK=gpt-5.2
CRAFT_MODEL_EMBEDDING=text-embedding-3-large
CRAFT_MODEL_ENDPOINT=
CRAFT_MODEL_KEY=
CRAFT_MODEL_MAX_OUTPUT_TOKENS=4000
CRAFT_AGENT_RUN_SECONDS=120
CRAFT_MCP_URL=http://127.0.0.1:8000/mcp
CRAFT_MCP_ACCOUNT=analyst
CRAFT_WOLFRAM_APP_ID=
# The workspace image a whole-notebook run starts, with no network (deploy/jupyterhub builds it).
CRAFT_NOTEBOOK_IMAGE=craft-user-workspace:local
# JupyterHub (deploy/jupyterhub/README.md): its address from CRAFT, the address the browser opens
# (empty: the same) and CRAFT's Hub service token (no expiry; rotate by hand). Empty: no workspaces.
CRAFT_HUB_URL=
CRAFT_HUB_PUBLIC_URL=
CRAFT_HUB_TOKEN=
# Sign-in at the identity provider: craft-id now; for Entra, change the first three only.
# Empty turns browser sign-in off. Laptop: register craft-app once with
#   craft id clients add craft-app \
#     --redirect-uri http://localhost:8000/api/auth/callback --redirect-uri http://localhost:8000/
# then set the authority to http://localhost:8100/id/6f1c0e2a-163b-4c2a-9e0d-0c5a1d3b7e42/v2.0
CRAFT_OIDC_AUTHORITY=
CRAFT_OIDC_CLIENT_ID=
CRAFT_OIDC_CLIENT_SECRET=
CRAFT_OIDC_REDIRECT_URI=http://localhost:8000/api/auth/callback
# username and password straight to craft-app: tests only
CRAFT_LOCAL_PASSWORD_SIGNIN=false
# craft-id: RSA private key (PEM); empty makes a new one at each start (laptop only)
CRAFT_ID_SIGNING_KEY=
CRAFT_ID_PUBLIC_URL=http://localhost:8100
