[
  {
    "name": "list_documents",
    "operation": "library.list_documents",
    "description": "List currently readable indexed documents within bounded scan and result limits.",
    "effects": "NONE",
    "needsApproval": false,
    "route": "GET /api/library/documents",
    "inputSchema": {
      "title": "DocumentList",
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 25
        }
      },
      "required": [],
      "additionalProperties": false,
      "$defs": {
        "DocumentList": {
          "title": "DocumentList",
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 25
            }
          },
          "required": [],
          "additionalProperties": false
        }
      }
    },
    "outputSchema": {
      "title": "DocumentCatalog",
      "type": "object",
      "properties": {
        "documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CatalogDocument"
          }
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "documents",
        "truncated"
      ],
      "additionalProperties": false,
      "$defs": {
        "DocumentCatalog": {
          "title": "DocumentCatalog",
          "type": "object",
          "properties": {
            "documents": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CatalogDocument"
              }
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "documents",
            "truncated"
          ],
          "additionalProperties": false
        },
        "CatalogDocument": {
          "title": "CatalogDocument",
          "type": "object",
          "properties": {
            "item": {
              "type": "string",
              "pattern": "^itm_[0-9a-f]{12}$"
            },
            "title": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "version": {
              "type": "integer",
              "minimum": 1
            },
            "classification": {
              "enum": [
                "protected-a",
                "protected-b",
                "unclassified"
              ]
            },
            "simulated": {
              "type": "boolean"
            }
          },
          "required": [
            "item",
            "title",
            "version",
            "classification",
            "simulated"
          ],
          "additionalProperties": false
        }
      }
    },
    "availableIn": [
      "api",
      "mcp",
      "chat",
      "read_only_query"
    ]
  },
  {
    "name": "ask_agent",
    "operation": "agent.ask_agent",
    "description": "Queue a question for the cited CRAFT runtime and return its job at once; get_answer\nreads the answer. For example a document question from an MCP application.",
    "effects": "NONE",
    "needsApproval": false,
    "route": "POST /api/agent/ask",
    "inputSchema": {
      "title": "AskAgent",
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "conversationId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "question"
      ],
      "additionalProperties": false,
      "$defs": {
        "AskAgent": {
          "title": "AskAgent",
          "type": "object",
          "properties": {
            "question": {
              "type": "string",
              "minLength": 1
            },
            "conversationId": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "uuid"
                },
                {
                  "type": "null"
                }
              ],
              "default": null
            }
          },
          "required": [
            "question"
          ],
          "additionalProperties": false
        }
      }
    },
    "outputSchema": {
      "title": "AskAgentQueued",
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "conversationId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "jobId",
        "conversationId"
      ],
      "additionalProperties": false,
      "$defs": {
        "AskAgentQueued": {
          "title": "AskAgentQueued",
          "type": "object",
          "properties": {
            "jobId": {
              "type": "string"
            },
            "conversationId": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "jobId",
            "conversationId"
          ],
          "additionalProperties": false
        }
      }
    },
    "availableIn": [
      "api",
      "mcp"
    ]
  },
